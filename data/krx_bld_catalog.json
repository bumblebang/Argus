      "asof": "T+0 regular ~15:40; full day ~18:10",
      "params": ["isuCd(ISIN)", "strtDd", "endDd"],
      "note": "isuSrtCd 불가 — ISIN(KR7…) 필수. 잔고는 30501 우선"
    },
    {
