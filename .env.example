# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# ── 필수 (시세·감시). 라이브 주문에도 필요 ────────────────────────
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 토스 /api/v1/accounts 의 accountSeq. 비우면 첫 계좌 자동조회 — doctor 로 확인 후 고정 권고.
TOSS_ACCOUNT_NO=

# true = 실주문 없음(페이퍼). 라이브로 바꾸려면 docs/SETUP_LIVE.md 를 따른다.
DRY_RUN=true

# ── 뇌 (둘 중 하나). cli 면 PATH 의 `claude` 를 씀 ────────────────
# ANTHROPIC_API_KEY=

# ── 선택. 없으면 해당 배선만 비고 기동은 됨 ──────────────────────
# DART_API_KEY=          # 국내 공시·재무 (open.dart.fss.or.kr)
# FRED_API_KEY=          # 미 매크로 (fred.stlouisfed.org)
# FINNHUB_API_KEY=       # 미 뉴스·실적 (finnhub.io)
# ECOS_API_KEY=          # 한은 매크로 (ecos.bok.or.kr)
# NTFY_TOPIC=            # 폰 푸시. 무인 운영이면 사실상 필요 (ntfy.sh)

# 고급/선택 — KRX 정보데이터(공매도·수급·프로그램·경보). 웹 로그인. 기본 경로에 넣지 않는다.
# 장후 배치(build_market_state)에서만 전량 조회. 라이브 1m/메인 전략은 Toss 유지.
# KRX_USER=
# KRX_PASS=

# KRX Open API (openapi.krx.co.kr) — VKOSPI·풋콜 → fear_kr.inputs. KRX_USER 와 별개.
# KRX_API_KEY=
